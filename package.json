{
  "name": "zirodshop",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.11",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.12.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "fastify": "^5.12.7",
    "immutable": "^5.1.9",
    "pino": "^10.4.0"
  },
  "version": "1.0.0",
  "description": "This Turborepo starter is maintained by the Turborepo core team.",
  "main": "index.js",
  "repository": {
